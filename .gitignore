/target
**/*.rs.bk
__pycache__/
*.pyc
*.sock

# Scratch of agents and probes. Never committed.
/.work/
/.tmp/

# Claude Code: the worktrees of parallel agents and the overrides of each
# machine. .claude/settings.json is shared and committed.
/.claude/worktrees/
/.claude/settings.local.json
/fuzz/target
/fuzz/artifacts
/fuzz/corpus

# The runner image of .github/workflows/runner-image.yml, built in the root
# of the checkout: the tree that a local run gives to a job leaves it out.
/runner-*.tar
/runner-*.tar.sha256
/oci/
/load.tar
