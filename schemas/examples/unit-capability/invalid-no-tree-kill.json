{
  "schema": 1,
  "kind": "podvm",
  "arch": "x86_64",
  "boundary": "redirect",
  "principal": "shared",
  "container": "none",
  "net": "broker",
  "secret_delivery": [
    "files"
  ],
  "credential_store": "private-dir",
  "mount_modes": [
    "rw"
  ],
  "rootfs_fresh": "yes",
  "limits": {
    "wall": "reported"
  },
  "egress_hold": "advisory",
  "kvm": "no"
}
