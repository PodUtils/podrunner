{
  "$id": "https://github.com/PodUtils/podrunner/schemas/run-report-public.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PublicReport",
  "description": "The public report (`run-report-public.v1`). It never names the host.",
  "type": "object",
  "properties": {
    "boundary": {
      "anyOf": [
        {
          "$ref": "#/$defs/Boundary"
        },
        {
          "type": "null"
        }
      ]
    },
    "exit_reason": {
      "$ref": "#/$defs/ExitReason"
    },
    "job_id": {
      "$ref": "#/$defs/JobId"
    },
    "refusal_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/RefusalCode"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "source": {
      "type": "string"
    },
    "tier": {
      "anyOf": [
        {
          "$ref": "#/$defs/Tier"
        },
        {
          "type": "null"
        }
      ]
    },
    "unit_kind": {
      "type": [
        "string",
        "null"
      ]
    },
    "wall_s": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schema",
    "job_id",
    "source",
    "wall_s",
    "exit_reason"
  ],
  "$defs": {
    "Boundary": {
      "description": "The boundary between a job and the host, weakest first. `redirect`\nrewrites file paths and is no isolation against hostile code.",
      "type": "string",
      "enum": [
        "none",
        "redirect",
        "confined",
        "guest"
      ]
    },
    "ExitReason": {
      "description": "How a job ended.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "success",
            "failure",
            "cancelled",
            "timeout",
            "unit-failed"
          ]
        },
        {
          "description": "Refused before a unit started: the report has `refusal_code`.",
          "type": "string",
          "const": "refused"
        },
        {
          "description": "Withdrawn at `wait_deadline_s`.",
          "type": "string",
          "const": "withdrawn"
        },
        {
          "description": "The runner name or the job id of the `started` event did not match.",
          "type": "string",
          "const": "job-mismatch"
        },
        {
          "description": "podrunner lost the job (a restart from `claimed` on).",
          "type": "string",
          "const": "lost"
        }
      ]
    },
    "JobId": {
      "type": "string",
      "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._-]{1,128}$"
    },
    "RefusalCode": {
      "description": "Why podrunner refuses a job.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "no-slot-of-kind",
            "image-stale",
            "event-not-allowed",
            "tier-mismatch",
            "tier-needs-guest",
            "boundary-not-available",
            "limit-not-enforceable",
            "hold-not-available",
            "egress-policy-unsupported",
            "arch-mismatch",
            "payload-not-pinned",
            "repo-scope-refused",
            "container-not-supported",
            "container-option-refused",
            "build-not-supported",
            "source-revoked",
            "credential-unavailable",
            "unit-start-failed"
          ]
        },
        {
          "description": "Reserved.",
          "type": "string",
          "const": "port-claimed"
        }
      ]
    },
    "Tier": {
      "description": "The trust tier of a job. It comes from the trust inputs of an offer,\nnever from a label; `local` comes only from the configuration.",
      "oneOf": [
        {
          "description": "A pull request from a fork.",
          "type": "string",
          "const": "untrusted"
        },
        {
          "description": "A member job of a configured organization.",
          "type": "string",
          "const": "trusted"
        },
        {
          "description": "Set only by the configuration.",
          "type": "string",
          "const": "local"
        }
      ]
    }
  }
}
