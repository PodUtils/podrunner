   "reason": "runs-on is not ubuntu-24.04"
  },
  {
   "id": "nightly.yml/cross",
   "reason": "the job has strategy"
  },
  {
   "id": "plants.yml/plants",
   "reason": "it applies the plants of podcrates, which its own upkeep keeps current"
  },
  {
   "id": "publish.yml/dry-run",
   "reason": "a step holds an expression"
  },
  {
   "id": "publish.yml/publish",
   "reason": "the job has needs"
  },
  {
   "id": "record-issues.yml/numbers",
   "reason": "an env holds an expression"
  },
  {
   "id": "release.yml/release",
   "reason": "an env holds an expression"
  },
  {
   "id": "secrets.yml/secrets",
   "reason": "it scans the whole history against the allowlist of podcrates, and verifies found secrets on the network"
  },
  {
   "id": "services.yml/watch",
   "reason": "the job has if"
  },
  {
   "id": "services.yml/measure",
   "reason": "the job has if"
  },
  {
